
generator client {
  provider = "prisma-client-js"

}


datasource db {
  provider = "mongodb" 
  url      = env("DATABASE_URL") 
}



model FlashcardSets {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  subject          String           @unique
  userId          String          @db.ObjectId
  user            User           @relation(fields: [userId], references: [id])
  flashcards       Flashcards[] 
  createdAt   DateTime         @default(now())
  updateAt    DateTime         @updatedAt
  numberOfCards   Int        
  lobby         Lobby[]   
  
}

model Flashcards {
  question        String    
  answer          String
  flashcardSetId    String  @db.ObjectId
  flashcardSet    FlashcardSets      @relation(fields: [flashcardSetId], references: [id])
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
createdAt   DateTime         @default(now())
  updateAt    DateTime         @updatedAt
  
  
}
model User {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  fullname        String
  password        String
  username        String
  email           String           @unique

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  flashcardSets   FlashcardSets[]

  // lobbies created
  lobbiesCreated  Lobby[]          @relation("creator")

  // many-to-many via id list
  lobbyIds        String[]         @db.ObjectId
  lobbiesPlaying  Lobby[]          @relation("participants", fields: [lobbyIds], references: [id])
  leaderboardEntries LeaderboardEntry[]
}

model Lobby {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  lobbyCode             String        @unique
  lobbyStatus           String

  createdBy             User          @relation("creator", fields: [creatorUserId], references: [id])
  creatorUserId         String        @db.ObjectId

  flashCardSet          FlashcardSets @relation(fields: [flashCardSetId], references: [id])
  flashCardSetId        String        @db.ObjectId

  leaderboard           Leaderboard?   
  leaderboardEntries    LeaderboardEntry[]

  // many-to-many via id list
  participantIds        String[]      @db.ObjectId
  participatingPlayers  User[]        @relation("participants", fields: [participantIds], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model Leaderboard {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  lobby           Lobby         @relation(fields: [lobbyId], references: [id])
  lobbyId         String        @db.ObjectId  @unique
  entries         LeaderboardEntry[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model LeaderboardEntry {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  leaderboard       Leaderboard   @relation(fields: [leaderboardId], references: [id])
  leaderboardId     String        @db.ObjectId
  lobby             Lobby         @relation(fields: [lobbyId], references: [id])
  lobbyId           String        @db.ObjectId
  player            User          @relation(fields: [playerId], references: [id])
  playerId          String        @db.ObjectId
  score             Int           @default(0)
  correctAnswers    Int           @default(0)
  incorrectAnswers  Int           @default(0)
  streak            Int           @default(0)
  rank              Int           @default(1)
  joinedAt          DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([leaderboardId, playerId])
  @@index([lobbyId, rank])
  @@index([playerId])
}
